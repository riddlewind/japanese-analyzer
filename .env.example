# Japanese analyzer server API config

# Gemini
GEMINI_API_URL=
GEMINI_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY is also used by the "real-world usage" corpus lookup (Search API)
DEEPSEEK_API_URL=
DEEPSEEK_API_KEY=
# Optional. Base URL for /v1/tools/search and /v1/tools/fetch. Defaults to https://api.deepseek.com
DEEPSEEK_TOOLS_API_URL=

# SenseNova
SENSENOVA_API_URL=
SENSENOVA_API_KEY=

# Qiniu Cloud AI Token API (moonshotai/kimi-k3-free)
QINIU_API_URL=
QINIU_API_KEY=

# Optional login password
CODE=

# AGPL-3.0 §13 disclosure (read at request time by the /legal page).
# If you deploy a modified version, point SOURCE_URL at the repository of the version you
# actually serve, not upstream. Leave it empty to fall back to the upstream repository.
# SOURCE_URL=https://github.com/you/your-fork
# SOURCE_VERSION=<commit or tag you deployed>
# MODIFICATION_NOTICE=<optional: what you changed>
# The equivalent NEXT_PUBLIC_SOURCE_URL / _VERSION / _NOTICE build-time variables still work
# (used by the Docker build args) but need a rebuild to change.
# The GitHub Actions image build fills both automatically (github.repository / github.sha), and
# Vercel derives them from VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG / VERCEL_GIT_COMMIT_SHA.
# Only local or custom builds need these set by hand.

# Optional Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional cookie transport override. Auto-detect HTTPS when unset.
# Set true behind an HTTPS reverse proxy; use false only for intentional HTTP deployments.
# AUTH_COOKIE_SECURE=true

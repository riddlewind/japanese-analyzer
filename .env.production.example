# Japanese analyzer production server config

# DeepSeek text provider and image OCR
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# Optional. Base URL for /v1/tools/search and /v1/tools/fetch (real-world usage lookup).
# DEEPSEEK_API_KEY above is reused as the search key. Defaults to https://api.deepseek.com
DEEPSEEK_TOOLS_API_URL=

# Gemini provider, optional OCR and Gemini TTS
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# SenseNova
SENSENOVA_API_URL=https://token.sensenova.cn/v1/chat/completions
SENSENOVA_API_KEY=

# Qiniu Cloud AI Token API (moonshotai/kimi-k3-free)
QINIU_API_URL=
QINIU_API_KEY=

# Optional login password
CODE=

# AGPL-3.0 §13 disclosure: the /legal page offers the Corresponding Source of the version
# actually served. Set these when running a modified deployment; no rebuild needed.
# SOURCE_URL=https://github.com/you/your-fork
# SOURCE_VERSION=
# MODIFICATION_NOTICE=

# Optional Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional cookie transport override. Auto-detect HTTPS when unset.
# Set true when TLS terminates at your reverse proxy.
# AUTH_COOKIE_SECURE=true
